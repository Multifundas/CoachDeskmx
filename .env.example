# Supabase — Project Settings → API en supabase.com
# Project URL y anon/public key son públicas (van al cliente).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: SECRETA. Solo servidor (seeds/admin). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# App — usada como origin del magic link (emailRedirectTo → /auth/callback).
# En producción pon la URL pública (p. ej. https://coachdesk.mx).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TZ=America/Mexico_City
